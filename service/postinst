#!/bin/sh
set -e

# Creates the account the service runs under and the data directories this
# package owns; qumir-private creates its own guestbook directory the same way.
if [ "$1" = "configure" ]; then
    if ! getent passwd qumir >/dev/null; then
        adduser --system --group --no-create-home \
                --home /var/lib/qumir-data \
                --gecos "Qumir playground service" \
                qumir
    fi
    install -d -o qumir -g qumir -m 0755 /var/lib/qumir-data /var/lib/qumir-data/shared
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
